# =============================================================================
# Adaptive Financial Fraud Detection — .gitignore
# =============================================================================

# ── Raw datasets (NEVER commit — too large, Kaggle ToS) ──────────────────────
Datasets/
datasets/

# ── Model artifacts — TRACKED (all under 100MB GitHub limit) ─────────────────
# experiments/E1_lightgbm/model.txt          → 6.64 MB  — teammates need this
# experiments/E1_lightgbm/preprocessing.joblib → 0.06 MB — needed for inference
# experiments/E1_lightgbm/predictions.parquet  → 3.19 MB — needed for Phase 2

# ── Encoding comparison outputs (regenerate locally) ─────────────────────────
experiments/E1_encoding_comparison/

# ── Keep these experiment artifacts (small, informative) ─────────────────────
# experiments/E1_lightgbm/metrics.json         → tracked
# experiments/E1_lightgbm/feature_names.json   → tracked
# experiments/E1_lightgbm/split_meta.json      → tracked
# experiments/E1_lightgbm/run_metadata.json    → tracked
# experiments/E1_lightgbm/*.png                → tracked
# experiments/E1_lightgbm/*.csv                → tracked
# experiments/E1_lightgbm/run.log              → tracked

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.env
.venv
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# ── Logs and temp ────────────────────────────────────────────────────────
*.tmp
*.temp
experiments/E2_gru/*.log

# ── PDF exports (generated from markdown — not version controlled) ─────────
reports/*.pdf

# ── E3 (Phase 3 — not yet ready for commit) ──────────────────────────────
experiments/E3_hybrid/

# ── Secrets / credentials ────────────────────────────────────────────────────
.env
*.key
*.pem
secrets.yaml
credentials.json

# Spark generated outputs and checkpoints
spark/output/

# Local Spark development artifacts
spark/benchmarks/results/
spark/test_stream_checkpoint/
spark/streaming/stream_processor_backup.py
venv311/
